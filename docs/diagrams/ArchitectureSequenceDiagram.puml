@startuml
!include style.puml
skinparam ArrowFontStyle plain

Actor User as user USER_COLOR
Participant ":UI" as ui UI_COLOR
Participant ":Logic" as logic LOGIC_COLOR
Participant "live:Model" as model MODEL_COLOR
Participant "proposed:ModelManager" as proposed MODEL_COLOR
Participant ":Storage" as storage STORAGE_COLOR

user -[USER_COLOR]> ui : "delete 1"
activate ui UI_COLOR

ui -[UI_COLOR]> logic : execute("delete 1")
activate logic LOGIC_COLOR

logic -[LOGIC_COLOR]> model : getAddressBook(), getUserPrefs(),\ngetFilteredPersonList()
activate model MODEL_COLOR
model --[MODEL_COLOR]> logic : current records, preferences, displayed clients
deactivate model

logic -[LOGIC_COLOR]> proposed : prepare snapshot with displayed clients
activate proposed MODEL_COLOR
proposed --[MODEL_COLOR]> logic
deactivate proposed

logic -[LOGIC_COLOR]> proposed : deletePerson(target)
activate proposed MODEL_COLOR
note over logic, proposed : The parsed command validates the displayed index\nand changes only the proposed model.
proposed --[MODEL_COLOR]> logic
deactivate proposed

logic -[LOGIC_COLOR]> storage : saveAddressBook(proposed data)
activate storage STORAGE_COLOR

storage -[STORAGE_COLOR]> storage : Save to file
activate storage STORAGE_COLOR_T1
storage --[STORAGE_COLOR]> storage
deactivate storage

storage --[STORAGE_COLOR]> logic
deactivate storage

logic -[LOGIC_COLOR]> model : setAddressBook(proposed data)
activate model MODEL_COLOR
model --[MODEL_COLOR]> logic
deactivate model

logic --[LOGIC_COLOR]> ui
deactivate logic

ui--[UI_COLOR]> user
deactivate ui
@enduml
