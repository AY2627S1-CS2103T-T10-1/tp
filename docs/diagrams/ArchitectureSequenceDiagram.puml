@startuml
!include style.puml
skinparam ArrowFontStyle plain
skinparam sequenceMessageAlign left
skinparam BoxPadding 8
skinparam dpi 140

participant ":UI" as ui UI_COLOR
participant ":Logic" as logic LOGIC_COLOR
participant "live:Model" as live MODEL_COLOR
participant "proposed:ModelManager" as proposed MODEL_COLOR
participant ":Storage" as storage STORAGE_COLOR

ui -> logic : execute("delete 1")

logic -> live : read snapshot inputs
live --> logic : snapshot inputs
create proposed
logic -> proposed : create snapshot
logic -> proposed : delete client 1
proposed --> logic : proposed records

logic -> storage : saveAddressBook(...)
alt save succeeds
    storage --> logic : saved
    logic -> live : setAddressBook(...)
    live --> logic
    logic --> ui : success result
else save fails
    storage --> logic : save failure
    note over live, proposed : Live records and filter remain unchanged.\nThe proposed snapshot is not published.
    logic --> ui : command error
end
@enduml
