@startuml
!pragma layout smetana
skinparam shadowing false
hide empty members
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam classBackgroundColor #E8F5E9
skinparam arrowColor #2E6B32

package UI {
  interface Ui
  class UiManager
  class MainWindow
  class CommandBox
  class ResultDisplay
  class PersonListPanel {
    selectedClientProperty()
    selectClient(client)
  }
  class ClientDetailsPanel {
    showClient(client)
  }
  class PersonCard
  class HelpWindow
  class StatusBarFooter
}
class Logic
class "Person / Project" as ClientModel

UiManager ..|> Ui
UiManager --> MainWindow
UiManager --> Logic
MainWindow --> Logic : executes commands
MainWindow *--> CommandBox
MainWindow *--> ResultDisplay
MainWindow *--> PersonListPanel
MainWindow *--> ClientDetailsPanel
MainWindow *--> StatusBarFooter
MainWindow --> HelpWindow
PersonListPanel --> "*" PersonCard
ClientDetailsPanel ..> ClientModel : displays
PersonCard ..> ClientModel

@enduml
