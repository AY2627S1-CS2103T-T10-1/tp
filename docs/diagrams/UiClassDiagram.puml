@startuml
!pragma layout elk
skinparam shadowing false
skinparam dpi 160
skinparam defaultFontSize 16
skinparam nodesep 90
skinparam linetype ortho
skinparam ranksep 90
hide empty members
hide circle
skinparam classAttributeIconSize 0
skinparam packageStyle package
skinparam classBackgroundColor #E8F5E9
skinparam arrowColor #2E6B32

package UI {
  class Ui <<interface>>
  class UiManager {
    - logic: Logic
  }
  class MainWindow {
    - resultDisplay: ResultDisplay
    - helpWindow: HelpWindow
  }
  class PersonListPanel
  class ClientDetailsPanel {
    + showClient(client: Person): void
  }
  class PersonCard
}
class Logic <<interface>>
class Person

UiManager .left.|> Ui
UiManager -down-> "1" MainWindow
MainWindow -right-> "1" Logic
MainWindow *-down-> "1" PersonListPanel
MainWindow *-down-> "1" ClientDetailsPanel
PersonListPanel -down-> "0..*" PersonCard
PersonCard -right-> "1" Person
@enduml
