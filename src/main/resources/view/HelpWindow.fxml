<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.Scene?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.stage.Stage?>

<fx:root resizable="true" title="ClientDesk Help" type="javafx.stage.Stage" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
  <icons>
    <Image url="@/images/help_icon.png" />
  </icons>
  <scene>
    <Scene>
      <stylesheets>
        <URL value="@ClientDesk.css" />
        <URL value="@HelpWindow.css" />
      </stylesheets>
      <VBox prefWidth="760.0" prefHeight="560.0" spacing="12.0" styleClass="help-workspace">
        <Label text="Command guide" styleClass="panel-heading" />
        <TextArea fx:id="commandHelp" editable="false" wrapText="true" VBox.vgrow="ALWAYS"
                  styleClass="record-text" />
        <HBox alignment="CENTER" fx:id="helpMessageContainer" spacing="10.0">
          <padding>
            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
          </padding>
          <Label fx:id="helpMessage" wrapText="true" HBox.hgrow="ALWAYS" />
          <Button fx:id="copyButton" mnemonicParsing="false" onAction="#copyUrl" text="Copy URL" />
        </HBox>
      </VBox>
    </Scene>
  </scene>
</fx:root>
