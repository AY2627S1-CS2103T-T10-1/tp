<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<HBox id="cardPane" fx:id="cardPane" styleClass="client-card" spacing="10"
      xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
  <Label fx:id="id" styleClass="client-index">
    <minWidth>
      <Region fx:constant="USE_PREF_SIZE" />
    </minWidth>
  </Label>
  <VBox spacing="4" HBox.hgrow="ALWAYS" minWidth="0">
    <Label fx:id="name" styleClass="cell_big_label" wrapText="true" />
    <Label fx:id="email" styleClass="cell_small_label" wrapText="true" />
    <Label fx:id="phone" styleClass="cell_small_label" wrapText="true" />
    <Label fx:id="address" styleClass="client-address" wrapText="true" />
    <Label fx:id="remark" styleClass="client-remark" wrapText="true" />
    <FlowPane fx:id="tags" />
  </VBox>
</HBox>
